FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
solvers
{
    p_rbgh
    {
        solver          GAMG;
        tolerance       1e-05;
        relTol          0.01;
        smoother        DIC;
        nPreSweeps      0;
        nPostSweeps     2;
        nFinestSweeps   2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    p_rbghFinal
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0;
        smoother        DIC;
        nPreSweeps      0;
        nPostSweeps     2;
        nFinestSweeps   2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    "(k.b|epsilon.b|omega.b)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.01;
    }

    "(k.b|epsilon.b|omega.b)Final"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.01;
    }

    "U.a|U.aFinal"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.01;
    }

    "U.b|U.bFinal"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.01;
    }

    "(alpha.a|alphaPlastic|pa)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.01;
    }

    "(alpha.aFinal|alphaPlasticFinal|paFinal)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.01;
    }

    Theta
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.01;
    }

    ThetaFinal
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.01;
    }
}

PIMPLE
{
    nOuterCorrectors    3;       // 3 outer PIMPLE iterations for stability
    nNonOrthogonalCorrectors 1; // mesh is orthogonal but 1 adds robustness
    nCorrectors         2;
    nAlphaCorr      2;
    correctAlpha    yes;         // enabled to stabilize concentration coupling at higher timesteps
}

relaxationFactors
{
    fields
    {
        p_rbgh              0.3;   // aggressive pressure damping
    }
    equations
    {
        "U.a"               0.5;   // sediment velocity - damped for stability
        "U.b"               0.7;   // fluid velocity
        "alpha.a"           0.5;   // phase fraction - damped to prevent overpacking
        "pa"                0.3;   // granular pressure - damped to prevent pressure spikes
        "k.b"               0.7;
        "omega.b"           0.7;
    }
}

