FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
solvers
{
    p_rbgh
    {
        solver          GAMG;
        tolerance       1e-05;  // optimized for speed
        relTol          0.05;
        smoother        GaussSeidel; // faster convergence
        nPreSweeps      1;
        nPostSweeps     1;
        nFinestSweeps   2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 200;
        agglomerator    faceAreaPair;
        mergeLevels     2;      // faster coarsening stage
    }

    p_rbghFinal
    {
        solver          GAMG;
        tolerance       5e-06;  // optimized for speed
        relTol          0.01;   // prevents solver from taking 200+ iterations at final step
        smoother        GaussSeidel;
        nPreSweeps      1;
        nPostSweeps     1;
        nFinestSweeps   2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 200;
        agglomerator    faceAreaPair;
        mergeLevels     2;
    }

    "(k.b|epsilon.b|omega.b)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.01;
    }

    "(k.b|epsilon.b|omega.b)Final"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.01;
    }

    "U.a|U.aFinal"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.01;
    }

    "U.b|U.bFinal"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.01;
    }

    "(alpha.a|alphaPlastic|pa)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.01;
    }

    "(alpha.aFinal|alphaPlasticFinal|paFinal)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.01;
    }

    Theta
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.01;
    }

    ThetaFinal
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.01;
    }
}

PIMPLE
{
    nOuterCorrectors    2;       // 2 outer PIMPLE iterations (standard for sedFoam at Co<=0.3)
    nNonOrthogonalCorrectors 0; // mesh is orthogonal, no non-ortho correction needed
    nCorrectors         1;       // 1 inner pressure corrector per outer loop
    nAlphaCorr      1;
    correctAlpha    yes;
}

// No under-relaxation needed at Co <= 0.3 with 2 outer correctors
// Removing relaxation eliminates artificial damping that slows convergence


