FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     sedFoam_rbgh;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         400;

deltaT          1e-5;   // very conservative startup - allows bed to settle before shockwaves

writeControl    adjustableRunTime;

writeInterval   5;      // Save every 5s instead of 1s to reduce disk space for 400s run

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable on;

adjustTimeStep  true;

maxCo           0.5;    // Optimal fluid Courant limit for PIMPLE (up to 4 outer correctors)

maxAlphaCo      0.5;    // Optimal phase Courant limit

maxDeltaT       1e-2;   // 10.0 ms timestep ceiling for high-speed execution under stable conditions

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
